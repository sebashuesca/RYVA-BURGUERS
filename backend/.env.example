# Copiar a backend/.env; sustituir los valores antes de ejecutar.
DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/riva_burguers
APP_ENV=development
# En Aiven/Koyeb usar true. Para MySQL local sin TLS se admite false solo en development.
DB_SSL_REQUIRED=false
# En Aiven descargar el certificado CA y usar una ruta absoluta, o definir
# MYSQL_SSL_CA_PEM como variable secreta multilínea en Koyeb.
MYSQL_SSL_CA=
CORS_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app
ADMIN_API_KEY=CAMBIAR_ESTA_CLAVE_POR_UN_SECRETO_LARGO
# Coordenadas de ejemplo; sustituir por la ubicación real de RIVA BURGUERS.
KITCHEN_LATITUDE=19.4326
KITCHEN_LONGITUDE=-99.1332
KITCHEN_STATIONS=2
DELIVERY_RADIUS_KM=5.0
DELIVERY_BASE_FEE=20.00
DELIVERY_FEE_PER_KM=5.00
DELIVERY_SPEED_KMH=20.0
